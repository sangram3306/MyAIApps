{
  "expo": {
    "name": "SP One",
    "slug": "tupuchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tupuchat",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/brand/SPONE_App_icon.png",
    "android": {
      "package": "com.tupuchat.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/SPONE_App_icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/sp_one_opening_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SP One to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow SP One to use speech recognition for voice input.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "963cf163-83a6-4680-a7cc-4a53488750d3"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tupuchat.app"
    }
  }
}
