{
  "expo": {
    "name": "SP One",
    "slug": "tupuchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tupuchat",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/brand/SPONE_App_icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/sp_one_opening_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.tupuchat.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/SPONE_App_icon.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/brand/sp_one_opening_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
