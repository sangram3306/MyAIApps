                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["label", "value"],
                      "additionalProperties": false
                    }
                  },
                  "synopsis": {
                    "type": "string"
